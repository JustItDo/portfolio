---
import { getCollection } from "astro:content";

const entries = await getCollection("case-studies");
const projekty = entries
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({
		nr: String(entry.data.order).padStart(2, "0"),
		slug: entry.id,
		nazwa: entry.data.title,
		opis: entry.data.summary,
		stack: entry.data.stack,
		status: entry.data.status,
		codeVisibility: entry.data.codeVisibility,
	}));
---

<section id="projekty" data-sekcja="projekty" class="relative px-[6vw] py-24 md:py-32 border-t border-line">
	<p class="cmd-line text-accent text-[13px] before:content-['$_'] before:opacity-70">
		<span data-cmd>ls -la projekty/</span>
	</p>

	<div id="projekty-grid" class="mt-7 grid grid-cols-1 md:grid-cols-2 gap-5">
		{
			projekty.map((p) => (
				<a
					href={`/case-studies/${p.slug}`}
					class="project-card group relative flex flex-col gap-4 rounded-[3px] border border-line p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-[3px]"
				>
					<svg
						class="ramka pointer-events-none absolute -inset-px h-[calc(100%+2px)] w-[calc(100%+2px)]"
						aria-hidden="true"
					>
						<rect width="100%" height="100%" rx="3" pathLength="100" />
					</svg>

					<div class="flex items-start justify-between gap-3 text-[11.5px] uppercase tracking-wide text-muted">
						<span>{p.nr}</span>
						<span class="text-right">{p.status}</span>
					</div>

					<h3 class="text-[19px] font-semibold text-accent" transition:name={`tytul-${p.slug}`}>
						<span data-tytul>{p.nazwa}</span>
					</h3>

					<p class="text-[13.5px] leading-[1.65] text-ink/85">{p.opis}</p>

					<div class="flex flex-wrap gap-2 mt-1">
						{p.stack.map((t) => (
							<span
								data-hover-scramble
								class="rounded-[3px] border border-line px-2 py-0.5 text-[11px] uppercase tracking-wide text-muted"
							>
								{t}
							</span>
						))}
					</div>

					<span class="text-[11px] uppercase tracking-wide text-muted">
						kod: {p.codeVisibility === "private" ? "repozytorium prywatne" : "publiczny"}
					</span>

					<span class="mt-auto pt-2 text-[13px] text-accent transition-transform group-hover:translate-x-1">
						&gt; case_study()
					</span>
				</a>
			))
		}
	</div>
</section>

<style>
	/* rysująca się ramka: akcentowy stroke prowadzony po obrysie karty
	   (pathLength=100 → dasharray/offset w "procentach" obwodu); stroke-width 2
	   z połową uciętą przez krawędź svg daje 1px idealnie na ramce CSS */
	.ramka rect {
		fill: none;
		stroke: var(--color-accent);
		stroke-width: 2;
		stroke-dasharray: 100;
		stroke-dashoffset: 100;
		transition: stroke-dashoffset 0.55s ease;
	}

	.project-card:hover .ramka rect,
	.project-card:focus-visible .ramka rect {
		stroke-dashoffset: 0;
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import { reduceMotion, scramble, typeCommand } from "../scripts/efekty";

	gsap.registerPlugin(ScrollTrigger);

	function init() {
		const sekcja = document.getElementById("projekty");
		if (!sekcja) return;

		// decode tytułu przy najechaniu na kartę — działa niezależnie od reveal
		sekcja.querySelectorAll<HTMLElement>(".project-card").forEach((karta) => {
			const tytul = karta.querySelector<HTMLElement>("[data-tytul]");
			if (!tytul) return;
			karta.addEventListener("mouseenter", () => {
				if (tytul.dataset.busy) return;
				tytul.dataset.busy = "1";
				scramble(tytul, 450).then(() => delete tytul.dataset.busy);
			});
		});

		if (reduceMotion()) return;

		const cmd = sekcja.querySelector("[data-cmd]");
		const karty = sekcja.querySelectorAll("#projekty-grid > *");
		const ramki = Array.from(sekcja.querySelectorAll<SVGRectElement>(".ramka rect"));

		gsap.set(karty, { opacity: 0, y: 16 });

		ScrollTrigger.create({
			trigger: sekcja,
			start: "top 75%",
			once: true,
			onEnter: () => {
				(cmd ? typeCommand(cmd) : Promise.resolve()).then(() => {
					gsap.to(karty, { opacity: 1, y: 0, duration: 0.65, ease: "power2.out", stagger: 0.12 });

					// ramka rysuje się raz przy wejściu karty i gaśnie; potem hover
					// przejmuje efekt przez CSS — na czas tweena wyłączamy transition,
					// żeby nie walczyła z GSAP o stroke-dashoffset
					ramki.forEach((r) => (r.style.transition = "none"));
					gsap
						.timeline({ onComplete: () => ramki.forEach((r) => r.removeAttribute("style")) })
						.fromTo(
							ramki,
							{ strokeDashoffset: 100 },
							{ strokeDashoffset: 0, duration: 0.9, ease: "power2.inOut", stagger: 0.12 },
							0.1,
						)
						.to(ramki, { opacity: 0, duration: 0.5, ease: "power1.out", stagger: 0.12 }, "-=0.45");
				});
			},
		});
	}

	document.addEventListener("astro:page-load", init);
</script>
